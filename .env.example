# ============================================
# VARIABLES D'ENVIRONNEMENT — ProLink
# Copie ce fichier en .env et remplis les valeurs
# ============================================

# --- Profil Spring Boot ---
SPRING_PROFILES_ACTIVE=render

# --- Base de données PostgreSQL ---
# Remplis avec les infos de ta base (Neon, Supabase, ou Render DB)
DB_HOST=ton-host.neon.tech
DB_PORT=5432
DB_NAME=prolink
DB_USERNAME=ton-user
DB_PASSWORD=ton-mot-de-passe

# --- Admin ---
ADMIN_PASSWORD=TonMotDePasseAdminIci

# --- Google OAuth2 ---
# Console : https://console.cloud.google.com/apis/credentials
# Callback autorisé : https://ton-app.onrender.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxx

# --- Email SMTP (Gmail) ---
# Mot de passe d'application : https://myaccount.google.com/apppasswords
MAIL_USERNAME=ton-email@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx

# --- Uploads ---
UPLOAD_DIR=/data/uploads/
